{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dingzi-blog",
  "main": "./src/server.ts",
  "compatibility_date": "2026-05-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 9 * * *"
    ]
  },
  "routes": [
    {
      "pattern": "dingzijiao.com",
      "custom_domain": true
    },
    {
      "pattern": "www.dingzijiao.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "VITE_BASE_URL": "https://dingzijiao.com",
    "CMS_PUBLIC_SITE_URL": "https://dingzijiao.com",
    "CMS_BACKUP_RETENTION_DAYS": "30",
    "CMS_EMAIL_SENDING_ENABLED": "false",
    "CMS_EMAIL_FROM": "",
    "CMS_EMAIL_TO": "",
    "CMS_PASSWORD_RESET_TTL_MINUTES": "30",
    "VITE_TURNSTILE_SITE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "dingzi-blog-cms",
      "database_id": "2d14a807-70a3-4ade-8f33-3bf25de72921",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CMS_STORAGE",
      "bucket_name": "dingzi-blog-assets"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CMS_CACHE",
      "id": "5ec5c3483c2d4576bb8bbb5a90395e5a"
    }
  ]
}
